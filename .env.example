# WordPress site URL (no trailing slash)
WP_BASE_URL=https://yoursite.com.au

# WordPress username
WP_USERNAME=your_username

# WordPress Application Password
# Generate at: WordPress Admin → Users → Your Profile → Application Passwords
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# WordPress REST endpoint for the location CPT
# Default is /wp-json/wp/v2/locations — override if your rest_base differs
WP_LOCATIONS_ENDPOINT=/wp-json/wp/v2/locations
